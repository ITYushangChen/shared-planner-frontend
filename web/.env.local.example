# 从 Supabase → Project Settings → API 复制
# 复制本文件为 .env.local 并填入真实值（不要提交 .env.local）

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Railway 后端公网地址（Settings → Networking → Generate Domain）
NEXT_PUBLIC_API_URL=https://shared-planner-backend-production-b60b.up.railway.app

# 注意：不要把 service_role 写进前端环境变量
